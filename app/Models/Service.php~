<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class Service extends Model
{
    use HasFactory;

    protected $fillable = [
        'image',
        'icon',
        'title',
        'titleCalculator',
        'description',
        'is_active',
        'base_price',
        'calculator_config',
        'formula'
    ];

    protected $casts = [
        'calculator_config' => 'array'
    ];
}
