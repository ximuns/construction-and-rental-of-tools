<?php

namespace App\Livewire;

use App\Models\CategoryPortfolio;
use Livewire\Component;

class Portfolio extends Component
{
    public $activeCategory = null;
    public  $categories;
    public  $portfolios;

    public function mount()
    {
        $this->categories = CategoryPortfolio::all();
        $this->portfolios = \App\Models\Portfolio::all();
    }

    public function filterByCategory($categoryId = null)
    {
        $this->activeCategory = $categoryId;

        if ($categoryId) {
            $this->portfolios = \App\Models\Portfolio::where('category_id', $categoryId)->get();
        } else {
            $this->portfolios = Portfolio::all();
        }
    }

    public function render()
    {
        return view('livewire.portfolio');
    }
}
