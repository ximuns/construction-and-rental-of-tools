.rent {
    width: 100%;
    background-color: #F9FAFB;
}

.rent__page {
    top: 0;
}

.rent__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 180px 0 120px 0;
}

.rent__title {
    font-size: 40px;
    color: #0A2463;
    font-weight: 600;
    margin: 20px 0;
}

.rent__subtitle {
    color: #A7B0C5;
    font-size: 20px;
    font-weight: 500;
    width: 100%;
    max-width: 545px;
    margin: 20px 0;
}

.rent__tabs {
    display: flex;
    gap: 10px;
    border-radius: 5px;
    background-color: #F5F5F4;
    padding: 5px;
    margin: 0 0 50px 0;
}

.rent__tab {
    margin: 0;
    padding: 6px 18px;
    font-size: 18px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: 600;
    color: #78716C;
    transition: all 300ms;
}

.rent__tab.active {
    color: #0A2463;
    background-color: #FFFFFF;
    border-bottom: 2px solid #000;
}

.rent__search {
    border: 1px solid #A7B0C5;
    border-radius: 5px;
    padding: 13px 10px;
    max-width: 450px;
    width: 100%;
    margin: 0 0 50px 0;
    font-size: 16px;

    input::placeholder {
        color: #A7B0C5;
    }
}

.rent__cardImg {
    max-width: 384px;
    width: 100%;
    object-fit: cover;
    justify-items: center;
    max-height: 160px;
    border-radius: 10px 10px 0 0;
}

.rent__availability.active {
    background-color: #FEE2E2;
    border: 1px solid #F5B8B8;
    color: #9B1E1E;
}


.rent__no-results {
    position: absolute;
    left: calc(33.33% + 10px); /* 1 колонка + половина gap */
    transform: translateX(-50%);
    top: 50%;
    transform: translate(-50%, -50%);
    width: calc(33.33% - 20px); /* Ширина колонки с учетом gap */
}
