                                <div class="calculator__input">
                                    <div class="calculator__label">
                                        <label class="calculator__nameInput">{{ $input['label'] }}</label>
                                        <p class="calculator__inputNumber">{{ $inputs[$input['key']] }}</p>
                                    </div>
                                    <input type="range"
                                           wire:model="inputs.{{ $input['key'] }}"
                                           wire:change="calculate"
                                           class="calculator__range"
                                           min="{{ $input['min'] ?? 0 }}"
                                           max="{{ $input['max'] ?? 100 }}"
                                           step="{{ $input['step'] ?? 1 }}">
                                </div>
                            @elseif($input['type'] === 'select')
                                <div class="calculator__select">
                                    <label class="calculator__nameInput">{{ $input['label'] }}</label>
                                    <select class="calculator__selectOptions"
                                            wire:model="inputs.{{ $input['key'] }}"
                                            wire:change="calculate">
                                        <option value="">Выберите...</option>
                                        @foreach($input['options'] as $option)
                                            <option value="{{ $option['value'] }}">{{ $option['label'] }}</option>
                                        @endforeach
                                    </select>
                                </div>
                            @elseif($input['type'] === 'checkbox_group')
                                <div class="calculator__services">
                                    <label class="calculator__nameInput">{{ $input['label'] }}</label>
                                    <div class="calculator__toggles">
                                        @foreach($input['inputs'] as $checkbox)
                                            <div class="calculator__toggle">
                                                <label class="calculator__switch">
                                                    <input type="checkbox"
                                                           wire:model="inputs.{{ $checkbox['key'] }}"
                                                           wire:change="calculate">
                                                    <span class="calculator__slider"></span>
                                                </label>
                                                <p class="calculator__toggleText">{{ $checkbox['label'] }}</p>
                                            </div>
                                        @endforeach
                                    </div>
                                </div>
                            @endif
                        </div>
                    @endforeach

                    <!-- Результат -->
                    <div class="calculator__result">
                        <div class="calculator__resultGroup">
                            <p class="calculator__resultText">Предварительная стоимость:</p>
